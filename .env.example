# ------------------------------------------------------------------
# Model access — entirely optional.
#
# With no key at all the engine runs in deterministic mode against the
# bundled evidence corpus, so the app still deploys and demos end to
# end. A key upgrades extraction, classification, critique, commerce
# copy and question answering to a live model.
#
# Set ONE provider. Gemini wins if both are present, unless
# LLM_PROVIDER says otherwise.
# ------------------------------------------------------------------

# --- Google Gemini ------------------------------------------------
GEMINI_API_KEY=

# Judgement calls: extraction, adversarial critique, commerce copy.
GEMINI_MODEL=gemini-3.1-pro-preview

# High-volume cheap calls: classification and normalization.
GEMINI_FAST_MODEL=gemini-3.7-flash

# --- Anthropic Claude ---------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Force a provider when both keys are set: "gemini" or "anthropic".
LLM_PROVIDER=

# Optional. Canonical origin for Open Graph and metadata URLs.
NEXT_PUBLIC_SITE_URL=

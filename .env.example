# Optional. Without a key the engine runs in deterministic demo mode using the
# bundled evidence corpus, so the app still deploys and demos end to end.
ANTHROPIC_API_KEY=

# Model used for the extraction and critic stages.
ANTHROPIC_MODEL=claude-sonnet-5

# Cheap model used for classification and normalization.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
